# 给 `make docker-run` 用，不要整份复用根目录 .env（那是宿主机直跑 API 的配置）。
APP_ENV=production
HTTP_PORT=8681
DATABASE_URL=postgresql://dauth:dauth@host.docker.internal:5432/dauth?sslmode=disable
REDIS_ADDR=host.docker.internal:6379
DAUTH_MASTER_KEY=dev-master-key-change-me-32b!!!!!!!!
DAUTH_PUBLIC_URL=http://localhost:8680
DAUTH_WEB_ORIGIN=http://localhost:8680
DAUTH_JWT_ISSUER=http://localhost:8680
# RS256：私钥自动生成到 /app/data/jwt-private.pem（需持久化卷），公钥走 /v1/.well-known/jwks.json
DAUTH_JWT_ALG=RS256
DAUTH_COOKIE_SECURE=false
DAUTH_COOKIE_NAME=dauth_session
DAUTH_ALLOWED_ORIGINS=http://localhost:8680,http://127.0.0.1:8680
DAUTH_INIT_ADMIN_PHONE=+8613800000000
