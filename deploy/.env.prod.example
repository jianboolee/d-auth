# ============================================================
# d-auth 生产环境变量（业务机 /opt/d-auth/.env.prod）
#
#   cp deploy/.env.prod.example deploy/.env.prod   # 然后填写
#   业务机：docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# 本文件含生产密钥，已在 .gitignore 中忽略，请勿提交。
# ============================================================

# ---------- 部署 ----------
REGISTRY=registry.cn-beijing.aliyuncs.com/xrv/d-auth
DOCKER_TAG=latest
# 应用容器对外端口（绑所有网卡）；入口机经内网 172.17.255.64:8680 反代
APP_PORT=8680

# ---------- 对外地址 ----------
DAUTH_PUBLIC_URL=https://auth.x-rv.com
DAUTH_WEB_ORIGIN=https://auth.x-rv.com
DAUTH_JWT_ISSUER=https://auth.x-rv.com
DAUTH_JWT_ALG=RS256
DAUTH_COOKIE_DOMAIN=.x-rv.com
DAUTH_COOKIE_SECURE=true
DAUTH_COOKIE_NAME=__Secure-dauth_session
DAUTH_ALLOWED_ORIGINS=https://auth.x-rv.com

# ---------- 数据库（外部实例）----------
# 全新库；容器启动时自动跑迁移
DATABASE_URL=postgres://<user>:<password>@<rds-host>:5432/dauth?sslmode=disable
REDIS_ADDR=<redis-host>:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 密钥（必填）----------
# JWT 签名算法：RS256（推荐，非对称）。私钥首次启动自动生成到
# /app/data/jwt-private.pem（app_data 卷持久化，换算法/删卷=旧 token 全失效）。
# 公钥发布在 /v1/.well-known/jwks.json，子服务直接拉取验签，无需共享密钥。
# 如沿用旧 HS256：设 DAUTH_JWT_ALG=HS256 并填 DAUTH_JWT_SECRET（≥32 字符，
# openssl rand -base64 48）。
# 加密主密钥：加密库里保存的各应用微信 AppSecret（AES-256-GCM）。
# 生成：openssl rand -base64 32
# ⚠️ 上线后不可再改，否则已保存的 AppSecret 无法解密，需重新录入。
DAUTH_MASTER_KEY=

# ---------- 首次超管 ----------
# 该手机号/邮箱首次登录即成为 superadmin（仅当库中尚无超管时）
DAUTH_INIT_ADMIN_PHONE=
DAUTH_INIT_ADMIN_EMAIL=

# ---------- 限流 / 反向代理 ----------
# ⚠️ 必须包含入口机内网 IP，否则所有请求被算作同一 IP，验证码 IP 限流会误封全体用户。
DAUTH_TRUSTED_PROXIES=127.0.0.1,::1,172.17.255.63
DAUTH_CODE_COOLDOWN=60s
DAUTH_CODE_PER_TARGET_HOUR=10
DAUTH_CODE_PER_IP_MINUTE=10
DAUTH_CODE_PER_IP_HOUR=100

# ---------- 阿里云 ----------
# ⚠️ 每把密钥必须与自己的 SK 配对：AK 与 SK 来自不同 RAM 用户会报 SignatureDoesNotMatch。
# 通用密钥，短信 / 邮件 / OSS 未单独配置时回退到它
DAUTH_ALIYUN_ACCESS_KEY_ID=
DAUTH_ALIYUN_ACCESS_KEY_SECRET=
# 各服务专用密钥（留空回退通用密钥）
DAUTH_ALIYUN_SMS_ACCESS_KEY_ID=
DAUTH_ALIYUN_SMS_ACCESS_KEY_SECRET=
DAUTH_ALIYUN_DM_ACCESS_KEY_ID=
DAUTH_ALIYUN_DM_ACCESS_KEY_SECRET=
DAUTH_OSS_ACCESS_KEY_ID=
DAUTH_OSS_ACCESS_KEY_SECRET=

# ---------- 短信模板 ----------
DAUTH_ALIYUN_SMS_SIGN_NAME=
DAUTH_ALIYUN_SMS_TEMPLATE_LOGIN=
DAUTH_ALIYUN_SMS_TEMPLATE_BIND=
DAUTH_ALIYUN_SMS_TEMPLATE_RESET=

# ---------- 邮件 ----------
DAUTH_ALIYUN_DM_ACCOUNT=
DAUTH_ALIYUN_DM_FROM_ALIAS=d-auth
DAUTH_ALIYUN_DM_REGION=cn-hangzhou

# ---------- OSS ----------
DAUTH_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
DAUTH_OSS_BUCKET=
DAUTH_OSS_ROOT_DIR=uploads
# 访问基地址，如 https://<bucket>.oss-cn-beijing.aliyuncs.com
DAUTH_OSS_CDN_BASE=
DAUTH_OSS_AVATAR_SUFFIX=?x-oss-process=image/resize,m_fill,w_360,h_360

# ---------- 微信登录（留空则该能力走 mock）----------
DAUTH_WECHAT_WEB_APP_ID=
DAUTH_WECHAT_WEB_APP_SECRET=
DAUTH_WECHAT_REDIRECT_URL=

# ---------- 运行 ----------
RUN_MIGRATIONS=true
TZ=Asia/Shanghai