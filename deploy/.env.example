# ============================================================
# d-auth 生产部署环境变量
#
#   cp deploy/.env.example deploy/.env
#   至少填 POSTGRES_PASSWORD、DAUTH_MASTER_KEY
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# 不要提交真实密钥。
# ============================================================

# ---------- 必填 ----------
POSTGRES_PASSWORD=
DAUTH_MASTER_KEY=

# ---------- 镜像 ----------
# DOCKER_IMAGE=jianboo/d-auth
# DOCKER_TAG=latest

# 应用对外端口（宿主机 -> 容器 80）。本项目约定 8680，外层 nginx 也按此转发
# APP_PORT=8680

# ---------- 对外地址 ----------
# DAUTH_PUBLIC_URL=https://auth.x-rv.com
# DAUTH_WEB_ORIGIN=https://auth.x-rv.com
# DAUTH_JWT_ISSUER=https://auth.x-rv.com
# DAUTH_COOKIE_DOMAIN=.x-rv.com
# DAUTH_COOKIE_SECURE=true
# DAUTH_COOKIE_NAME=__Secure-dauth_session
# DAUTH_ALLOWED_ORIGINS=https://auth.x-rv.com,https://a.x-rv.com

# ---------- 数据库 ----------
# POSTGRES_USER=dauth
# POSTGRES_DB=dauth

# ---------- 首次超管 ----------
# DAUTH_INIT_ADMIN_PHONE=+8613800000000

# ---------- 其它 ----------
# RUN_MIGRATIONS=true
# TZ=Asia/Shanghai
