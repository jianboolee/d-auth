# ============================================================
# d-auth 生产部署环境变量
#
#   cp deploy/.env.example deploy/.env
#   至少填 POSTGRES_PASSWORD、DAUTH_MASTER_KEY
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# 不要提交真实密钥。
# ============================================================

# ---------- 必填 ----------
POSTGRES_PASSWORD=
# 加密主密钥：加密库里保存的各应用微信 AppSecret（AES-256-GCM）。
# 生成：openssl rand -base64 32
# 上线后不要再改，否则已保存的 AppSecret 无法解密，需重新录入。
DAUTH_MASTER_KEY=
# HMAC 密钥，至少 32 字符。其它服务用同一把验 HS256 access token
DAUTH_JWT_SECRET=

# ---------- 镜像 ----------
# DOCKER_IMAGE=jianboo/d-auth
# DOCKER_TAG=latest

# 应用对外端口（宿主机 -> 容器 80）。本项目约定 8680，外层 nginx 也按此转发
# APP_PORT=8680

# ---------- 对外地址 ----------
# DAUTH_PUBLIC_URL=https://auth.x-rv.com
# DAUTH_WEB_ORIGIN=https://auth.x-rv.com
# DAUTH_JWT_ISSUER=https://auth.x-rv.com
# DAUTH_JWT_ALG=HS256
# DAUTH_COOKIE_DOMAIN=.x-rv.com
# DAUTH_COOKIE_SECURE=true
# DAUTH_COOKIE_NAME=__Secure-dauth_session
# DAUTH_ALLOWED_ORIGINS=https://auth.x-rv.com,https://a.x-rv.com

# ---------- 数据库 ----------
# POSTGRES_USER=dauth
# POSTGRES_DB=dauth

# ---------- 首次超管 ----------
# DAUTH_INIT_ADMIN_PHONE=+8613800000000
# 会话滑动续期节流（cookie 模式）：活跃时最多每 24h 顺延一次过期时间。
# DAUTH_SESSION_RENEW_INTERVAL=24h

# ---------- 验证码限流（防短信轰炸）----------
# 目标维度是硬上限（不区分 scene）；IP 维度用于挡批量枚举。
# 生产若经外层 nginx 反代，DAUTH_TRUSTED_PROXIES 必须包含 nginx 的地址，
# 否则所有请求会被算作同一个 IP 而误封全部用户。
# DAUTH_CODE_COOLDOWN=60s
# DAUTH_CODE_PER_TARGET_HOUR=10
# DAUTH_CODE_PER_IP_MINUTE=10
# DAUTH_CODE_PER_IP_HOUR=100
# DAUTH_TRUSTED_PROXIES=127.0.0.1,::1

# ---------- 阿里云 ----------
# 通用密钥，短信 / 邮件 / OSS 未单独配置时回退到它
# DAUTH_ALIYUN_ACCESS_KEY_ID=
# DAUTH_ALIYUN_ACCESS_KEY_SECRET=
# 各服务专用密钥（留空回退通用密钥）
# DAUTH_ALIYUN_SMS_ACCESS_KEY_ID=
# DAUTH_ALIYUN_SMS_ACCESS_KEY_SECRET=
# DAUTH_ALIYUN_DM_ACCESS_KEY_ID=
# DAUTH_ALIYUN_DM_ACCESS_KEY_SECRET=
# DAUTH_OSS_ACCESS_KEY_ID=
# DAUTH_OSS_ACCESS_KEY_SECRET=
# DAUTH_ALIYUN_SMS_SIGN_NAME=
# DAUTH_ALIYUN_SMS_TEMPLATE_LOGIN=
# DAUTH_ALIYUN_DM_ACCOUNT=

# ---------- OSS ----------
# DAUTH_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# DAUTH_OSS_BUCKET=
# 对象键根目录：<bucket>/<ROOT_DIR>/<userID>/<name>
# DAUTH_OSS_ROOT_DIR=uploads
# 访问基地址：<CDN_BASE>/<ROOT_DIR>/<userID>/<name>
# DAUTH_OSS_CDN_BASE=https://<bucket>.oss-cn-hangzhou.aliyuncs.com
# 头像统一追加的图片处理后缀（360x360 正方形裁剪）；置空则不加
# DAUTH_OSS_AVATAR_SUFFIX=?x-oss-process=image/resize,m_fill,w_360,h_360

# ---------- 其它 ----------
# 容器启动时自动迁移；改为 false 则只启动应用
# RUN_MIGRATIONS=true
# TZ=Asia/Shanghai
