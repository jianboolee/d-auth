# Server
# 本项目独占 8680-8682，避免和 Vite 5173、常见 8080、d-specs 8400 段冲突。
#   8680  生产对外（nginx 单入口：控制台 + /v1）
#   8681  API（本地直连；生产只在容器回环）
#   8682  Web vite
# Postgres / Redis 不单独占端口，用默认 5432 / 6379（make up 也映射到默认端口）。
DAUTH_ENV=dev
HTTP_PORT=8681
DAUTH_PUBLIC_URL=http://localhost:8681
DAUTH_WEB_ORIGIN=http://localhost:8682

# Postgres / Redis（make up 映射到默认的 5432 / 6379）
DAUTH_POSTGRES_DSN=postgres://dauth:dauth@localhost:5432/dauth?sslmode=disable
DAUTH_REDIS_ADDR=localhost:6379
DAUTH_REDIS_PASSWORD=
DAUTH_REDIS_DB=0

# Cookie / CORS（localhost 不要设 Domain）
DAUTH_COOKIE_DOMAIN=
DAUTH_COOKIE_SECURE=false
DAUTH_COOKIE_NAME=dauth_session
DAUTH_ALLOWED_ORIGINS=http://localhost:8682,http://127.0.0.1:8682,http://localhost:8680,http://127.0.0.1:8680

# JWT
#   HS256：其它 Go 服务用同一把 DAUTH_JWT_SECRET / JWT_SECRET 验签（推荐）
#   RS256：不配密钥时沿用 RSA，公钥在 /v1/.well-known/jwks.json
DAUTH_JWT_ISSUER=http://localhost:8681
DAUTH_JWT_ALG=HS256
DAUTH_JWT_SECRET=dev-jwt-hs256-change-me-please-32b!!!!
DAUTH_JWT_PRIVATE_KEY_PATH=
DAUTH_JWT_ACCESS_TTL=15m
DAUTH_JWT_REFRESH_TTL=720h

# 首次匹配该手机/邮箱的登录会提升为 superadmin（只发生一次）
DAUTH_INIT_ADMIN_PHONE=+8613800000000
DAUTH_INIT_ADMIN_EMAIL=

# 验证码有效期（短信/邮件）。短信模板里的「X 分钟内有效」按此值生成，两边保持一致。
DAUTH_CODE_TTL=5m

# 验证码发送限流。发送接口是公开的，这几项是防短信轰炸/邮件滥用的关键。
# 目标维度（手机号/邮箱）是硬上限：不区分 scene，换 scene 也共用同一配额。
# IP 维度用于挡住批量枚举号段；注意公司/学校/运营商 CGNAT 下多人共用一个公网 IP，
# 默认值过小会误封正常用户，请结合日志里的 "code send rate limited" 调参。
DAUTH_CODE_COOLDOWN=60s          # 同一目标两次发送的最小间隔
DAUTH_CODE_PER_TARGET_HOUR=10    # 同一目标每小时上限
DAUTH_CODE_PER_IP_MINUTE=10      # 同一来源 IP 每分钟上限
DAUTH_CODE_PER_IP_HOUR=100       # 同一来源 IP 每小时上限
# 可信代理：只有来自这些地址的请求才会采信 X-Forwarded-For 取真实客户端 IP。
# 默认值对应「nginx 与 app 同机/同容器」的部署形态；换拓扑务必同步修改，
# 否则所有请求会被算作同一个 IP，IP 限流将误封全部用户。
DAUTH_TRUSTED_PROXIES=127.0.0.1,::1

# 加密主密钥：用于加密数据库里保存的「各应用微信 AppSecret」
# （auth_clients.wechat_app_secret_enc，AES-256-GCM，密钥取 SHA256(该值)）。
# 新增 / 修改应用时加密写入，微信登录时解密读取。
# 设置建议：
#   - 生成随机值，例如：openssl rand -base64 32
#   - 长度无硬性限制，但请用足够随机的长串；生产环境务必改掉默认值
#   - 一旦上线不要再改：改了会导致已加密的 AppSecret 无法解密，需重新录入
#   - 与数据库同样重要，请备份；泄露等于 AppSecret 泄露
DAUTH_MASTER_KEY=dev-master-key-change-me-32b!!!!!!!!

# 阿里云（空则 mock）
# 下面是通用密钥，短信 / 邮件 / OSS 未单独配置时都会回退到它。
DAUTH_ALIYUN_ACCESS_KEY_ID=
DAUTH_ALIYUN_ACCESS_KEY_SECRET=

# 各服务专用密钥（留空则分别回退到上面的通用密钥）
DAUTH_ALIYUN_SMS_ACCESS_KEY_ID=
DAUTH_ALIYUN_SMS_ACCESS_KEY_SECRET=
DAUTH_ALIYUN_SMS_SIGN_NAME=
DAUTH_ALIYUN_SMS_TEMPLATE_LOGIN=
DAUTH_ALIYUN_SMS_TEMPLATE_BIND=
DAUTH_ALIYUN_SMS_TEMPLATE_RESET=

DAUTH_ALIYUN_DM_ACCESS_KEY_ID=
DAUTH_ALIYUN_DM_ACCESS_KEY_SECRET=
DAUTH_ALIYUN_DM_ACCOUNT=
DAUTH_ALIYUN_DM_FROM_ALIAS=d-auth
DAUTH_ALIYUN_DM_REGION=cn-hangzhou

DAUTH_OSS_ACCESS_KEY_ID=
DAUTH_OSS_ACCESS_KEY_SECRET=
DAUTH_OSS_ENDPOINT=
DAUTH_OSS_BUCKET=
# 对象键的根目录，文件会存到 <bucket>/<ROOT_DIR>/<userID>/<name>
DAUTH_OSS_ROOT_DIR=uploads/avatars
# CDN / 访问基地址，最终 URL = <CDN_BASE>/<ROOT_DIR>/<userID>/<name>
DAUTH_OSS_CDN_BASE=http://localhost:8682/static
# 头像 URL 统一追加的图片处理后缀（阿里云 OSS 图片处理）
# 默认按 360x360 正方形裁剪填充；置空则不加后缀
DAUTH_OSS_AVATAR_SUFFIX=?x-oss-process=image/resize,m_fill,w_180,h_180

DAUTH_WECHAT_WEB_APP_ID=
DAUTH_WECHAT_WEB_APP_SECRET=
DAUTH_WECHAT_REDIRECT_URL=http://localhost:8681/v1/auth/wechat/callback
